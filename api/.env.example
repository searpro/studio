# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://studio:studio_dev_password@localhost:5432/studio_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Auth.js
AUTH_SECRET=your-super-secret-auth-key-change-this-in-production
AUTH_URL=http://localhost:3000

# S3 Storage (MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=studio-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Inference Server
INFERENCE_CALLBACK_URL=http://localhost:3000/api/jobs/callback
