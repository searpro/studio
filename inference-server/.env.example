# AWS / S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=studio-assets
S3_REGION=us-east-1

# Redis
REDIS_URL=redis://localhost:6379

# API Callback
API_CALLBACK_URL=http://localhost:3000/api/jobs/callback

# Model Configuration
MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
DEVICE=cuda
# For CPU testing: DEVICE=cpu
# For MPS (Apple Silicon): DEVICE=mps

# Generation Defaults
DEFAULT_STEPS=30
DEFAULT_GUIDANCE_SCALE=7.5
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024
