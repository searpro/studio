"""
Image generation pipeline using T5B/Z-Image-Turbo-FP8
"""

import torch
from diffusers import ZImagePipeline
from PIL import Image
import logging
from typing import Optional
from src.config import settings

logger = logging.getLogger(__name__)

class ImageGenerationPipeline:
    """Manages FLUX pipeline for image generation."""
    
    def __init__(self):
        """Initialize the pipeline with model loading."""
        model_id = settings.model_id
        logger.info(f"Loading model: {model_id}")
        logger.info(f"Using device: {settings.device}")
        
        # Use float16 for memory efficiency (MPS supports float16)
        # FLUX.2-klein-4B claims ~13GB VRAM - float32 doubles memory usage
        if settings.device == "cuda":
            dtype = torch.bfloat16
        else:
            dtype = torch.float16  # Use float16 for MPS to reduce memory
        
        logger.info(f"Using dtype: {dtype}")
        
        # Load T5B/Z-Image-Turbo-FP8 pipeline
        self.pipe = ZImagePipeline.from_pretrained(
            model_id,
            torch_dtype=dtype,
        )
        
        # Enable CPU offloading to reduce GPU memory usage
        # This keeps model on CPU and moves layers to GPU/MPS only when needed
        # self.pipe.enable_sequential_cpu_offload(device=settings.device)
        self.pipe.enable_model_cpu_offload()
        
        # Additional memory optimizations
        self.pipe.enable_attention_slicing(slice_size="auto")
        
        logger.info("Pipeline loaded successfully")
    
    def generate(
        self,
        prompt: str,
        negative_prompt: str = "",
        num_inference_steps: Optional[int] = None,
        guidance_scale: Optional[float] = None,
        width: int = 1024,
        height: int = 1024,
        seed: Optional[int] = None,
    ) -> Image.Image:
        """
        Generate an image from a prompt using T5B/Z-Image-Turbo-FP8.
        
        Args:
            prompt: Text prompt for generation
            negative_prompt: Things to avoid (FLUX may ignore this)
            num_inference_steps: Number of denoising steps (default: 4 for schnell)
            guidance_scale: How closely to follow the prompt (default: 0.0 for FLUX)
            width: Output width
            height: Output height
            seed: Random seed for reproducibility
            
        Returns:
            Generated PIL Image
        """
        logger.info(f"Generating image with prompt: {prompt[:100]}...")
        
        # FLUX.1-schnell optimized defaults (fast 4-step inference)
        if num_inference_steps is None:
            num_inference_steps = 4
        if guidance_scale is None:
            guidance_scale = 0.0  # FLUX.2-klein uses guidance_scale=1.0
        
        # Set seed if provided
        generator = None
        if seed is not None:
            generator = torch.Generator(device=settings.device).manual_seed(seed)
        else:
            import random
            seed = random.randint(0, 2**32 - 1)
            generator = torch.Generator(device=settings.device).manual_seed(seed)
        
        logger.info(f"Steps={num_inference_steps}, CFG={guidance_scale}, Seed={seed}, Size={width}x{height}")
        
        # Generate
        with torch.inference_mode():
            result = self.pipe(
                prompt=prompt,
                num_inference_steps=num_inference_steps,
                guidance_scale=guidance_scale,
                width=width,
                height=height,
                generator=generator,
            )
        
        image = result.images[0]
        logger.info("Image generated successfully")
        
        return image
